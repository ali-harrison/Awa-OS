# AWA/OS environment variables
# Copy to .env.local and fill in. Never put real values in this file: it's committed.

# ─── SUPABASE ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Must be the public anon/publishable key (eyJ… or sb_publishable_…).
# NEXT_PUBLIC_ values ship to the browser, so a secret key must never go here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ─── PORTAL ───────────────────────────────────────────────────────────────────
# Signs client portal session cookies. Optional: falls back to SUPABASE_SERVICE_ROLE_KEY.
# Changing it logs all clients out. Generate one with: openssl rand -base64 32
PORTAL_SESSION_SECRET=

# ─── RESEND ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=

# ─── STRIPE ───────────────────────────────────────────────────────────────────
# Optional: without a key, invoices are created with no online payment link.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── INVOICES & PORTAL DETAILS ────────────────────────────────────────────────
NEXT_PUBLIC_BANK_ACCOUNT=
# Digits only, with country code. Leave blank to hide the portal's WhatsApp link.
NEXT_PUBLIC_WHATSAPP_NUMBER=
